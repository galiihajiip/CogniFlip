# Placeholder only. Never commit real credentials.
# Copy to .env.local for local development. Blank values count as "not set".
# Integrations are all-or-nothing: set every variable in a group or none.
# Validation lives in src/server/config/env.ts (server) and src/config/public-env.ts (browser).

# ---------------------------------------------------------------------------
# App (server-only). Required in production.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PUBLIC — inlined into the browser bundle at build time. Never put secrets here.
# Database group (with SUPABASE_SERVICE_ROLE_KEY below):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_.

# Database group
SUPABASE_SERVICE_ROLE_KEY=
# Optional, for migrations; postgres:// or postgresql://
DATABASE_URL=

# AI group. LLM_PROVIDER allowed values: anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text group
STT_PROVIDER=
STT_API_KEY=

# Text-to-speech group
TTS_PROVIDER=
TTS_API_KEY=

# Code runner group (https required in production)
CODE_RUNNER_PROVIDER=
CODE_RUNNER_BASE_URL=
CODE_RUNNER_API_KEY=

# Optional error reporting
ERROR_REPORTING_DSN=

# ---------------------------------------------------------------------------
# Limits (server-only). Blank uses the default; values are whole numbers.
# AI_MAX_REQUESTS_PER_MINUTE: default 10, max 600
# AI_MAX_CALLS_PER_SESSION:   default 6, max 50
# AI_TIMEOUT_SECONDS:         default 30, max 120
# CODE_RUN_MAX_SECONDS:       default 5, max 30
# CODE_RUN_MAX_OUTPUT_BYTES:  default 65536, max 1048576
AI_MAX_REQUESTS_PER_MINUTE=
AI_MAX_CALLS_PER_SESSION=
AI_TIMEOUT_SECONDS=
CODE_RUN_MAX_SECONDS=
CODE_RUN_MAX_OUTPUT_BYTES=
